# Copy to .env and fill in real values. Never commit the real .env.

# --- Server -------------------------------------------------------------
APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bubblewhite

# --- JWT --------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_HOURS=72

# --- Cloudflare R2 (S3-compatible) — product/category image storage -----
# Account ID appears in your R2 dashboard URL; endpoint follows this pattern.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=bubblewhite-media
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Public URL your bucket is served from (R2 public bucket URL or custom domain / CDN in front of it)
R2_PUBLIC_URL=https://media.bubblewhite.co

# --- Default admin, created by seed on first boot (change password after first login) ---
SEED_ADMIN_EMAIL=admin@bubblewhite.co
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Bakong Open API — real, server-side payment verification -------------
# Used to independently verify Bakong payments before an order is ever
# created (see services/bakong_payment.go, OrderService.Checkout) — this
# backend NEVER trusts a client-supplied "I paid" claim, it always checks
# with Bakong itself. Sign up for Open API access at
# https://api-bakong.nbc.gov.kh. IMPORTANT: this is a SEPARATE deployment/
# process from the Nuxt frontend — the frontend has its OWN identical set
# of these same variables (see the frontend's .env.example) for ITS OWN
# customer-facing polling check. Setting these here does NOT configure the
# Nuxt frontend, and vice versa — both need to be set independently, or
# checkout will fail with "Bakong payment verification is not configured
# on this server" even though the frontend's own check succeeds.
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
# Same value as the Nuxt frontend's BAKONG_ACCOUNT_ID (used there for QR
# generation) — this backend uses it to confirm a verified payment actually
# landed in the business's own account, not just that Bakong reported SOME
# transaction as successful. Shown as a clear match/mismatch banner on the
# admin order detail page's "view transaction detail" panel.
BAKONG_ACCOUNT_ID=
BAKONG_API_EMAIL=
# Optional. If set, used directly as the API token instead of calling
# renew_token with BAKONG_API_EMAIL — useful for testing, or as a stopgap.
# Leave blank for the normal flow (BAKONG_API_EMAIL + automatic renewal,
# cached in the database — see models.BakongToken).
BAKONG_API_TOKEN=

# --- Internal service-to-service auth --------------------------------------
# Protects GET /api/internal/bakong-token — the endpoint the Nuxt frontend
# calls to fetch this backend's already-cached Bakong token, instead of
# independently calling Bakong's renew_token itself. MUST be the exact same
# value as INTERNAL_API_SECRET on the Nuxt frontend — generate any long
# random string and use it on both. Never expose this value publicly; it's
# not a customer/admin credential, just a shared password between your own
# two services.
INTERNAL_API_SECRET=

# --- PPCBank Payment Gateway — second KHQR payment option -----------------
# Credentials obtained via PPCBank account manager (not self-service).
# Requires your server's public IP to be whitelisted with PPCBank first —
# requests will fail even with correct credentials if the IP isn't registered.
PPCBANK_API_BASE_URL=https://paytest.ppcbank.com.kh
PPCBANK_MERCHANT_CODE=
PPCBANK_PASSWORD=
# Full URLs on THIS site that PPCBank redirects the customer back to after
# payment — a per-request billNumber query param is appended automatically
# (see services/ppcbank_payment.go), so these should just be the base path,
# e.g. https://bubblewhite.co/orders/ppcbank-return
PPCBANK_SUCCESS_URL=
PPCBANK_ERROR_URL=

# --- Telegram order-paid notifications -------------------------------------
# Optional — if either is blank, notifications are silently skipped (never
# blocks or fails checkout). To set up: message @BotFather on Telegram to
# create a bot and get TELEGRAM_BOT_TOKEN, add that bot to your group, then
# get the group's chat ID (e.g. via the bot's getUpdates endpoint after
# sending a message in the group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Your storefront's public origin, no trailing slash — used to turn the
# order reference in Telegram notifications into a real clickable link
# straight to that order's admin review page. Optional: if blank, the
# order reference is just shown as plain text instead of a link.
FRONTEND_BASE_URL=
