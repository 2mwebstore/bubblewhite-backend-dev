# Copy to .env and fill in real values. Never commit the real .env.

# --- Server -------------------------------------------------------------
APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional, comma-separated — IPs exempt from all rate limiting (your own
# office IP, a monitoring/health-check service, etc). Leave blank for no
# exemptions.
RATE_LIMIT_ALLOWLIST=

# Google/Facebook customer sign-in. GOOGLE_CLIENT_ID must be the exact same
# client ID configured as NUXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend — it's
# checked against every Google ID token's "aud" claim, so a mismatch here
# means every Google sign-in fails closed (the safe default). Get these
# from Google Cloud Console (OAuth client ID, type "Web application") and
# Facebook's developer dashboard (an app's Settings > Basic page).
# FACEBOOK_APP_SECRET must never be exposed to the frontend — only this
# backend ever sends it, to Facebook's own debug_token endpoint.
GOOGLE_CLIENT_ID=926439679405-1rcnte9mp54nkeqp53tsula161qmii0o.apps.googleusercontent.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- MySQL ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bubblewhite

# --- JWT --------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_HOURS=72

# --- Cloudflare R2 (S3-compatible) — product/category image storage -----
# Account ID appears in your R2 dashboard URL; endpoint follows this pattern.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=bubblewhite-media
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Public URL your bucket is served from (R2 public bucket URL or custom domain / CDN in front of it)
R2_PUBLIC_URL=https://media.bubblewhite.co

# --- Default admin, created by seed on first boot (change password after first login) ---
SEED_ADMIN_EMAIL=admin@bubblewhite.co
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- PPCBank Payment Gateway — second KHQR payment option -----------------
# Credentials obtained via PPCBank account manager (not self-service).
# Requires your server's public IP to be whitelisted with PPCBank first —
# requests will fail even with correct credentials if the IP isn't registered.
PPCBANK_API_BASE_URL=https://paytest.ppcbank.com.kh
PPCBANK_MERCHANT_CODE=
PPCBANK_PASSWORD=
# Full URLs on THIS site that PPCBank redirects the customer back to after
# payment — a per-request billNumber query param is appended automatically
# (see services/ppcbank_payment.go), so these should just be the base path,
# e.g. https://bubblewhite.co/orders/ppcbank-return
PPCBANK_SUCCESS_URL=
PPCBANK_ERROR_URL=

# --- Telegram order-paid notifications -------------------------------------
# Optional — if either is blank, notifications are silently skipped (never
# blocks or fails checkout). To set up: message @BotFather on Telegram to
# create a bot and get TELEGRAM_BOT_TOKEN, add that bot to your group, then
# get the group's chat ID (e.g. via the bot's getUpdates endpoint after
# sending a message in the group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Your storefront's public origin, no trailing slash — used to turn the
# order reference in Telegram notifications into a real clickable link
# straight to that order's admin review page. Optional: if blank, the
# order reference is just shown as plain text instead of a link.
FRONTEND_BASE_URL=
